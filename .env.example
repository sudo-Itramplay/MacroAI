# Fitxer .env.example
# ====================
# Model configuration per role (format: provider/model)
# All agents use OpenCode CLI with different --model flags.
# Leave blank to use defaults (shown below).

# Fast model for prompt optimization and simple code tasks
MACROAI_OPTIMIZER_MODEL=opencode-go/deepseek-v4-flash
MACROAI_SIMPLE_MODEL=opencode-go/deepseek-v4-flash

# Powerful model for architecture, complex code, and memory archival
MACROAI_ARCHITECT_MODEL=opencode-go/deepseek-v4-pro
MACROAI_COMPLEX_MODEL=opencode-go/deepseek-v4-pro
MACROAI_FINALIZER_MODEL=opencode-go/deepseek-v4-pro

# Base directory for generated project files (default: ./macroai_projects)
# Each session gets its own subfolder: <MACROAI_PROJECTS_DIR>/<session_id>/
MACROAI_PROJECTS_DIR=./macroai_projects

# Maximum seconds to wait per opencode call (default: 600)
# Increase this if your tasks time out with complex models
MACROAI_TIMEOUT=600
